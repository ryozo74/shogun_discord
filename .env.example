# Discord Bot Integration (see docs/discord_setup.md)
DISCORD_BOT_TOKEN=
DISCORD_USER_ID=
DISCORD_CMD_CHANNEL_ID=
DISCORD_DASHBOARD_CHANNEL_ID=

# Discord Multi-Shogun Routing (cmd_442)
# Set to "true" to enable per-shogun mention routing (requires separate Bot per shogun)
DISCORD_MULTI_SHOGUN=
# Auto-detected from GET /users/@me. Override if auto-detection fails.
DISCORD_BOT_USER_ID=
# Optional: Discord role id for shogun group (@role mention also triggers all-shogun routing)
DISCORD_SHOGUN_ROLE_ID=
